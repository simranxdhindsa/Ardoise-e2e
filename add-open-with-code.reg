Windows Registry Editor Version 5.00

; Open with Code - for files
[HKEY_CLASSES_ROOT\*\shell\Open with Code]
@="Open with Code"
"Icon"="C:\\Users\\Simran\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe,0"

[HKEY_CLASSES_ROOT\*\shell\Open with Code\command]
@="\"C:\\Users\\Simran\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe\" \"%1\""

; Open with Code - for folders (background right-click inside a folder)
[HKEY_CLASSES_ROOT\Directory\Background\shell\Open with Code]
@="Open with Code"
"Icon"="C:\\Users\\Simran\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe,0"

[HKEY_CLASSES_ROOT\Directory\Background\shell\Open with Code\command]
@="\"C:\\Users\\Simran\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe\" \"%V\""

; Open with Code - for folders (right-click on a folder)
[HKEY_CLASSES_ROOT\Directory\shell\Open with Code]
@="Open with Code"
"Icon"="C:\\Users\\Simran\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe,0"

[HKEY_CLASSES_ROOT\Directory\shell\Open with Code\command]
@="\"C:\\Users\\Simran\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe\" \"%1\""
